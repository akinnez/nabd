{
  "name": "nabd",
  "version": "1.1.0",
  "description": "A lightweight, high-performance reactivity engine for Fintech. Built for predictable state, precision speed, and bank-grade safety.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "bench": "tsx bench/resources.bench.ts",
    "publish": "npm run build && npm publish --access public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "mitata": "^1.0.34",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },

  "keywords": [
    "web",
    "react",
    "nextjs",
    "typescript",
    "reactivity",
    "rx",
    "pulse",
    "nabd",
    "signals",
    "computed",
    "effect",
    "reversion",
    "debounce",
    "debounceSignal",
    "resource",
    "resourceApi",
    "mutation",
    "action",
    "useSignal",
    "useSignalEffect",
    "linkedSignal",
    "toSignal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akinnez/nabd.git"
  },
  "bugs": {
    "url": "https://github.com/akinnez/nabd/issues"
  },
  "homepage": "https://github.com/akinnez/nabd#readme",

  "author": "Oladejo Akinola Idris",
  "contributors": [
    "Oladejo Akinola Idris (https://github.com/akinnez)"
  ]
}

